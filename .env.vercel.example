# Referência para Settings > Environment Variables no Vercel.
# Não contém credenciais. O destino deve ser um backend CPU persistente já hospedado.
# Deixe vazio somente para exibir a página pública em modo de configuração.
AUTOPOSTS_BACKEND_URL=
# Mesma chave privada forte no backend e no Vercel para limites por IP corretos.
# Pelo menos 32 caracteres aleatórios; não reutilize APP_SECRET.
AUTOPOSTS_GATEWAY_SECRET=
APP_EDITION=saas
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=

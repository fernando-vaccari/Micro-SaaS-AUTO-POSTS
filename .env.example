# Desenvolvimento local: copie para .env. Nunca versione valores secretos.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
DATA_DIR=.data
# Em development, APP_SECRET vazio gera chave persistida em DATA_DIR/.app-secret.
# Em production, defina segredo estável com >= 32 caracteres e APP_BASE_URL HTTPS público.
APP_SECRET=

# Instagram API com Instagram Login. Cadastre o redirect exato no app Meta.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0

# Stripe: use chaves de teste primeiro. O webhook precisa ser HTTPS público.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# IA opcional para campanhas. Modo templates funciona sem credencial.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

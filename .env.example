# Copie para .env; nunca envie valores secretos ao Git ou ao chat.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
DATA_DIR=.data
# production exige HTTPS e chave estável >=32 caracteres (guarde backup separado).
APP_SECRET=
# local SOMENTE para desenvolvimento. production exige b2.
STORAGE_BACKEND=local
B2_BUCKET_NAME=autoposts-media-fernando
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
MEDIA_RETENTION_DAYS=10
RENDER_REQUESTS_PER_HOUR=30

# Meta: Instagram API with Instagram Login; redirect exato no painel do app.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0

# Stripe: primeiro sandbox. Quatro Prices BRL mensais, portal e webhook assinado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PREMIUM=
# Compatibilidade com a instalação anterior: fallback somente para Pro.
STRIPE_PRICE_ID=
PLAN_STARTER_PRICE_CENTS=2999
PLAN_STARTER_VIDEOS=10
PLAN_STARTER_IMAGES=5
PLAN_PRO_PRICE_CENTS=6999
PLAN_PRO_VIDEOS=20
PLAN_PRO_IMAGES=10
PLAN_BUSINESS_PRICE_CENTS=10999
PLAN_BUSINESS_VIDEOS=50
PLAN_BUSINESS_IMAGES=25
PLAN_PREMIUM_PRICE_CENTS=15999
PLAN_PREMIUM_VIDEOS=80
PLAN_PREMIUM_IMAGES=40

# Recuperação e verificação de e-mail. Configure remetente verificado no provedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# IA opcional; templates funcionam sem chave.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Opcional: segredo >=32 caracteres para um processador remoto confiável.
AUTOPOSTS_API_SECRET=

# Identificação pública do responsável (revisar termos e privacidade antes da venda).
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_UPDATED_AT=
# Docker: domínio/DNS reais só para perfil public. Porta local permanece privada.
AUTOPOSTS_DOMAIN=localhost
ACME_EMAIL=
AUTOPOSTS_BIND_IP=127.0.0.1
AUTOPOSTS_PORT=8000
